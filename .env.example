VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Dropbox backup (optional)
# 1. Go to https://www.dropbox.com/developers/apps
# 2. Create app → "Scoped access" → "App folder" access
# 3. Under OAuth 2 → Redirect URIs, add your app's URL (e.g. http://localhost:5173/)
# 4. Copy the App key here:
VITE_DROPBOX_APP_KEY=your-dropbox-app-key
